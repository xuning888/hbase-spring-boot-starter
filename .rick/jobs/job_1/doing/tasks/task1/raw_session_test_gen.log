path.dirname(os.path.dirname(script_dir)))))\n    compose_file = os.path.join(project_root, 'deploy', 'docker-compose.yaml')\n    \n    # ---- KR2: Prerequisites ----\n    \n    # Test 1: docker-compose.yaml exists\n    if not os.path.exists(compose_file):\n        errors.append(f'{compose_file} does not exist')\n    \n    # Test 2: Docker is running\n    try:\n        result = subprocess.run(['docker', 'info'], capture_output=True, text=True, timeout=30)\n        if result.returncode != 0:\n            errors.append(f'Docker is not running: {result.stderr.strip()}')\n    except FileNotFoundError:\n        errors.append('docker command not found')\n    except subprocess.TimeoutExpired:\n        errors.append('docker info timed out')\n    except Exception as e:\n        errors.append(f'Failed to check Docker status: {e}')\n    \n    # Test 3: Rosetta emulation precheck (arm64 Mac)\n    if not errors:  # Only if Docker is available\n        try:\n            result = subprocess.run(\n                ['docker', 'run', '--rm', '--platform', 'linux/amd64', 'alpine', 'uname', '-m'],\n                capture_output=True, text=True, timeout=120\n            )\n            if result.returncode != 0 or 'x86_64' not in result.stdout:\n                errors.append(\n                    'Rosetta emulation check failed. '\n                    'Enable Rosetta in Docker Desktop settings (VM memory >= 4GB recommended). '\n                    f'stdout: {result.stdout.strip()}, stderr: {result.stderr.strip()}'\n                )\n        except subprocess.TimeoutExpired:\n            errors.append('Rosetta check timed out - emulation may be too slow. Enable Rosetta in Docker Desktop.')\n        except Exception as e:\n            errors.append(f'Rosetta check failed: {e}')\n    \n    # Test 4: Required ports are free\n    # ... (check 2181, 16000, 16010, 16201, 16301)\n    \n    # Test 5: /etc/hosts contains 127.0.0.1 hbase\n    # ...\n    \n    # If compose file doesn't exist, we can't proceed with docker compose operations\n    if not os.path.exists(compose_file):\n        result = {'pass': False, 'errors': errors}\n        print(json.dumps(result))\n        sys.exit(1)\n    \n    # ---- Normal Path: Start HBase and verify readiness ----\n    \n    # Test 6: docker compose up -d\n    # ...\n    \n    # Test 7-11: Readiness checks (curl, nc, rootdir, ps, logs)\n    # ...\n    \n    # ---- Boundary: Idempotent Restart ----\n    \n    # Test 12: docker compose up -d again (no recreate)\n    # ...\n    \n    # Test 13: Readiness still passes, curl still 200\n    # ...\n    \n    # ---- Exception Path: Restart Recovery + Persistence ----\n    \n    # Test 14: Write test data\n    # ...\n    \n    # Test 15: docker compose down && up -d\n    # ...\n    \n    # Test 16: Verify data persisted\n    # ...\n    \n    # Test 17: Cleanup\n    # ...\n    \n    result = {'pass': len(errors) == 0, 'errors': errors}\n    print(json.dumps(result))\n    sys.exit(0 if result['pass'] else 1)\n\nif __name__ == '__main__':\n    main()\n```\n\nThis is getting complex. Let me write it carefully.\n\nWait, about the port check on macOS: `lsof -nP -iTCP:2181 -iTCP:16000 -iTCP:16010 -iTCP:16201 -iTCP:16301 -sTCP:LISTEN` should have no output.\n\nFor the nc check: what does \"nc returns imok\" mean? It's probably `echo 'imok' | nc localhost <someport>` - actually it might mean using the HBase status check, or maybe it's `nc -z localhost <port>` returning ok. Let me think about this more carefully...\n\nActually, looking at the test description again: \"nc 返回 `imok`\" - this is a ZooKeeper-style health check. In ZooKeeper, you can send \"ruok\" via netcat to get \"imok\". But wait, that's ZooKeeper's four-letter word command on port 2181, not HBase's. Let me use `echo ruok | nc localhost 2181` and expect `imok` in response.\n\nFor curl: `curl -sf http://localhost:16010/master-status` should return 200 with content containing the RegionServer record with \"hbase\".\n\nFor rootdir check: \"rootdir 校验输出含 `/hbase-data`\" - this likely means checking the HBase root directory. Maybe through `docker exec hbase hbase org.apache.hadoop.hbase.util.HBaseFsck` or checking the HBase info page. Actually maybe it's simpler - check via `docker exec hbase ls /hbase-data` to verify the data directory exists.\n\nActually wait, let me re-read: \"rootdir 校验输出含 `/hbase-data`\" - this seems to check that HBase's root directory path contains `/hbase-data`, probably by querying HBase config. We could do `docker exec hbase hbase org.apache.hadoop.hbase.util.HBaseConfTool hbase.rootdir` or check the master-status page.\n\nLet me simplify: check through `docker exec hbase ls /hbase-data` to verify it exists and has content.\n\nFor logs: `docker compose -f deploy/docker-compose.yaml logs --tail 50 hbase` should have 0 ERROR/Fatal lines (or only startup transient).\n\nWait, actually thinking about this more... some of these operations (like writing data with hbase shell) are complex and could fail for many reasons. The test script should be robust.\n\nLet me also think about what the compose file path should be. The compose file is at `deploy/docker-compose.yaml` relative to project root. When running docker compose commands, I need to either:\n1. `cd` to project root and use `-f deploy/docker-compose.yaml`\n2. Use absolute path `-f /absolute/path/to/deploy/docker-compose.yaml`\n\nI'll use absolute path for safety.\n\nAlso a critical note: the compose project name should be set to something like `hbase-test` to avoid conflicts with other projects. But actually, the prompt says to use `-f deploy/docker-compose.yaml` without specifying a project name. Let me use the directory name which is the default. Actually, I should add `-p hbase-test` or something to ensure isolation. But the prompt doesn't mention this...\n\nLet me just follow the exact commands specified in the test methods. The test says `docker compose -f deploy/docker-compose.yaml up -d`.\n\nOK let me write the full script now. I'll be thorough but keep it readable.\n\nActually, one more consideration: the subprocess calls. On macOS, `subprocess.run` with `shell=True` is fine for most commands. But for `docker compose`, it might be easier to use `shell=True`.\n\nAlso for lsof: `lsof -nP -iTCP:2181 -iTCP:16000 -iTCP:16010 -iTCP:16201 -iTCP:16301 -sTCP:LISTEN` - this will fail (return code 1) if no process is listening on those ports, which is what we want. I need to handle this correctly.\n\nLet me write the script now. I'll be very careful about error handling and edge cases.","signature":"5260e8bf-4bad-48eb-89a0-ed868bf806f6"}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":707,"cache_creation_input_tokens":0,"cache_read_input_tokens":40320,"output_tokens":0,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"d357c5e6-0108-4463-931d-044b28229c72","uuid":"74a8a8e2-09e8-4753-801f-a871cd9f57e0"}
